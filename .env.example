# Server Settings
PROJECT_NAME="Enterprise Payroll Management System"
ENVIRONMENT="development"
SECRET_KEY="super-secret-enterprise-payroll-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="payroll_user"
POSTGRES_PASSWORD="payroll_password"
POSTGRES_DB="payroll_db"
DATABASE_URL="postgresql://payroll_user:payroll_password@localhost:5432/payroll_db"

# Redis Settings
REDIS_HOST="localhost"
REDIS_PORT=6379

# Initial Admin Credentials
INITIAL_ADMIN_EMAIL="admin@enterprise-payroll.com"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
